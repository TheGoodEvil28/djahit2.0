server {
    #listen 443 ssl;
        listen 80;
    server_name djahit.andikanugra.my.id;

#    ssl_certificate /etc/letsencrypt/live/djahit.andikanugra.my.id/fullchain.pem;
 #   ssl_certificate_key /etc/letsencrypt/live/djahit.andikanugra.my.id/privkey.pem;

    # Serve frontend
    root /var/www/djahit2.0;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Proxy API to backend container/port
    location /api/ {
        proxy_pass http://127.0.0.1:8880;   # or backend container address
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Handle CORS preflight
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'POST, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Content-Type';
            return 204;
        }
    }

    location /predict {
        proxy_pass http://127.0.0.1:8009;  # Docker exposes YOLO here
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Handle CORS preflight
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'POST, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Content-Type';
            return 204;
        }
    }

}